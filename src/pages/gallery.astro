---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/site.js';

const D = "font-family:'Big Shoulders Display',sans-serif";
---
<Base
  title="Gallery | Vancouver Wolfpack Landscaping"
  description="Retaining walls, paving stones, driveways, fences and backyards built by Vancouver Wolfpack Landscaping in Langley, Surrey and Metro Vancouver."
>
<main>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) 32px">
    <h1 style={`${D};font-weight:900;font-size:clamp(72px,11vw,200px);line-height:0.82;text-transform:uppercase;margin:0`}>Gallery</h1>
  </section>
  <section style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(64px,8vw,112px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:4px">
      {gallery.map((p, i) => (
        <div style="aspect-ratio:1/1;overflow:hidden;background:#1B1E1A"><img src={p} alt={`Wolfpack landscaping project ${i + 1}`} loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
      ))}
    </div>
  </section>
</main>
</Base>
