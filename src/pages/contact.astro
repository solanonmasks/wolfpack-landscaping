---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';

const D = "font-family:'Big Shoulders Display',sans-serif";
const label = 'display:flex;flex-direction:column;gap:8px;font-weight:700';
const field = 'font-size:18px;padding:16px;border:2px solid #3A3F38;background:#1B1E1A;color:#ECE8DF';
const needs = [
  'Retaining wall', 'Paving stones or interlock driveway', 'Concrete driveway', 'Fencing',
  'Patio, deck or pergola', 'Excavation or drain tile', 'Lawn maintenance', 'Something else',
];
---
<Base
  title="Free Quote | Vancouver Wolfpack Landscaping"
  description="Get a free landscaping or hardscaping quote in Langley, Surrey or Metro Vancouver. Call Mike at 778-919-7181 or send the form. Callback within 24 hours."
  showCta={false}
>
<main>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) clamp(64px,8vw,112px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px 80px;align-items:start">
    <div>
      <h1 style={`${D};font-weight:900;font-size:clamp(64px,8vw,140px);line-height:0.82;text-transform:uppercase;margin:0 0 18px`}>Free <span style="color:#A9CC5A">quote</span></h1>
      <p style="margin:0 0 32px;font-size:20px;color:#CFCAC0">Tell us about the job. Mike calls back within 24 hours, guaranteed.</p>

      <form id="quote-form" action={site.formEndpoint} method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px">
        <input type="hidden" name="_subject" value="New quote request from the website" />
        <label style={label}>Name<input required name="name" autocomplete="name" style={field} /></label>
        <label style={label}>Phone<input required type="tel" name="phone" autocomplete="tel" style={field} /></label>
        <label style={label}>Email<input type="email" name="email" autocomplete="email" style={field} /></label>
        <label style={label}>City
          <select name="city" style={field}>{site.formCities.map((c) => <option>{c}</option>)}</select></label>
        <label style={`grid-column:1/-1;${label}`}>What do you need?
          <select name="need" style={field}>{needs.map((n) => <option>{n}</option>)}</select></label>
        <label style={`grid-column:1/-1;${label}`}>Tell us about it
          <textarea name="details" rows="5" placeholder="Sloped backyard in Walnut Grove. Want a block wall and a flat paver patio off the back deck." style={`${field};resize:vertical;line-height:1.5`}></textarea></label>
        <div style="grid-column:1/-1">
          <button type="submit" class="btn-green" style={`${D};font-weight:900;font-size:24px;text-transform:uppercase;padding:18px 36px;border:none;cursor:pointer`}>Send it</button>
          <p id="form-error" role="alert" hidden style="margin:16px 0 0;color:#FFB4A8;font-weight:600">Sorry, that didn’t send. Please try again, or call Mike at <a href={site.phoneHref}>{site.phone}</a>.</p>
        </div>
      </form>

      <div id="form-thanks" hidden style="background:#8DB33A;color:#111311;padding:clamp(28px,4vw,48px);flex-direction:column;gap:12px">
        <h2 style={`${D};font-weight:900;font-size:60px;line-height:0.9;text-transform:uppercase;margin:0`}>Got it.</h2>
        <p style="margin:0;font-weight:600">Mike will call you back within 24 hours.</p>
        <div><button id="form-reset" type="button" style="background:#111311;color:#ECE8DF;border:none;font-weight:700;font-size:16px;padding:12px 20px;cursor:pointer">Send another</button></div>
      </div>
    </div>

    <aside style="background:#1B1E1A;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:26px;border-top:6px solid #8DB33A">
      <div><span style="font-weight:700;font-size:14px;letter-spacing:0.2em;color:#A9CC5A">CALL MIKE</span><a href={site.phoneHref} style={`display:block;${D};font-weight:900;font-size:clamp(56px,5.6vw,92px);line-height:0.95;color:#FFFFFF;text-decoration:none`}>{site.phone}</a></div>
      <div><strong style="display:block">Email</strong><a href={`mailto:${site.email}`} style="overflow-wrap:anywhere">{site.email}</a></div>
      <div><strong style="display:block">Where we work</strong>Langley, Surrey and across Metro Vancouver. Larger commercial jobs across BC.</div>
      <div><a href={site.facebook} target="_blank" rel="noopener" style="font-weight:700">Facebook</a></div>
    </aside>
  </section>
</main>
</Base>

<style is:global>
  #form-thanks:not([hidden]) { display: flex; }
</style>

<script is:inline>
  // Sends the quote form to Formspree without leaving the page,
  // then shows the "Got it." panel (or an error message).
  (function () {
    var form = document.getElementById('quote-form');
    var thanks = document.getElementById('form-thanks');
    var error = document.getElementById('form-error');
    var reset = document.getElementById('form-reset');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      error.hidden = true;
      var btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Form error');
          form.reset();
          form.hidden = true;
          thanks.hidden = false;
          window.scrollTo(0, 0);
        })
        .catch(function () { error.hidden = false; })
        .finally(function () { btn.disabled = false; });
    });

    reset.addEventListener('click', function () {
      thanks.hidden = true;
      form.hidden = false;
    });
  })();
</script>
